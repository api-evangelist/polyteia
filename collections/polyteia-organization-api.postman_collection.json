  "info": {
    "_postman_id": "91415123-acfe-4cc1-b279-75766a5a357b",
    "name": "Polyteia Platform Dataset Organization API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Polyteia is a data platform for the German/European public sector. The platform can be fully driven through an RPC-style API: a single endpoint that accepts `command` (create/update/delete) and `query` (read) calls against Organizations, Workspaces, Solutions and Datasets. Authentication uses a Personal Access Key (PAK) presented as a Bearer token. All requests are POST to the single endpoint and return HTTP 200 with either a `data` or an `error` object (except auth failures, which return 401).\n\n\nContact Support:\n Name: Polyteia Support\n Email: security@polyteia.de",
      "type": "text/plain"
    }
  }
