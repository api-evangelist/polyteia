  "info": {
    "_postman_id": "1d92d5c2-d18b-4ffd-8124-e75094e04220",
    "name": "Polyteia Platform Organization API",
    "description": "Polyteia is a data platform for the German/European public sector. The platform can be fully driven through an RPC-style API: a single endpoint that accepts `command` (create/update/delete) and `query` (read) calls against Organizations, Workspaces, Solutions and Datasets. Authentication uses a Personal Access Key (PAK) presented as a Bearer token. All requests are POST to the single endpoint and return HTTP 200 with either a `data` or an `error` object (except auth failures, which return 401).\n\nContact Support:\n Name: Polyteia Support\n Email: security@polyteia.de",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:06:41.000Z",
    "updatedAt": "2026-10-22T01:06:41.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-1d92d5c2-d18b-4ffd-8124-e75094e04220"
  },
